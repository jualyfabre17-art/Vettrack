@page 
@model VettrackWeb.Pages.Mascotas.MascotaIndexModel
@{
}
<section class="mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h1 class="h3">Mascotas registradas</h1>
        <a class="btn btn-success" asp-page="Create" >Registrar mascota</a>
    </div>
</section>

<form method="get" class="mb-3" style="max-width:320px;">
    <select name="Filtro" class="form-select" onchange="this.form.submit()">
        <option value="">Todos los tipos</option>
        <option value="Perro">Perro</option>
        <option value="Gato">Gato</option>
        <option value="Ave">Ave</option>
        <option value="Exótico">Exótico</option>
    </select>
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Tipo</th>
                <th>Edad</th>
                <th>Costo consulta base</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model.Mascotas)
            {
                <tr>
                    <td>@m.Nombre</td>
                    <td><span class="badge bg-secondary">@m.TipoMascota</span></td>
                    <td>@m.EdadEnAnios años</td>
                    <td>@m.CalcularCostoConsultaBase().ToString("C")</td>
                    <td><a asp-page="Details" asp-route-id="@m.Id" class="btn btn-sm btn-outline-primary">Ver</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>